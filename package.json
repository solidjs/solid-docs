{
	"name": "solid-docs-next",
	"version": "1.0.0",
	"private": true,
	"description": "Docs for Solid",
	"type": "module",
	"scripts": {
		"sync:orama": "pnpm build && node scripts/sync-orama.mjs",
		"dev": "vite dev",
		"build": "vite build && pnpm build:llms",
		"build:llms": "node scripts/build-llms.mjs dist/client",
		"start": "vite preview",
		"e2e": "npx playwright test",
		"format": "prettier . --write",
		"lint:fix": "eslint --flag unstable_native_nodejs_ts_config . --fix",
		"check:lint": "eslint --flag unstable_native_nodejs_ts_config .",
		"check:types": "tsc --noEmit",
		"sync:ref": "node scripts/extract-solid-ref.mjs",
		"sync:diagnostics": "node scripts/extract-diagnostics.mjs",
		"check:examples": "node scripts/check-examples.mjs",
		"lint:tone": "node scripts/lint-tone.mjs"
	},
	"dependencies": {
		"@kobalte/solidbase": "file:./spike/kobalte-solidbase-0.6.3-dev.tgz",
		"@solidjs/meta": "1.0.0-next.2",
		"@solidjs/router": "2.0.0-next.42",
		"@solidjs/web": "2.0.0-rc.18",
		"@tailwindcss/vite": "^4.3.3",
		"dotenv": "^17.4.2",
		"resolve": "1.22.12",
		"solid-js": "2.0.0-rc.18",
		"solid-list": "^0.3.0",
		"solid-repl": "file:spike/solid-repl-0.26.0.tgz",
		"solidbase-osmium": "workspace:*",
		"vite": "8.2.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify-json/heroicons": "^1.2.3",
		"@kobalte/tailwindcss": "^0.9.0",
		"@orama/crawly": "^0.0.6",
		"@solidjs/vite-plugin": "3.0.0-next.51",
		"@tailwindcss/typography": "^0.5.20",
		"@types/node": "^25.9.5",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"@typescript/native": "npm:typescript@^7.0.0",
		"eslint": "^10.7.0",
		"eslint-plugin-solid": "^0.14.5",
		"globals": "^17.7.0",
		"prettier": "3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4.3.3",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.65.0"
	},
	"engines": {
		"node": ">=24",
		"pnpm": ">=11"
	},
	"packageManager": "pnpm@11.20.0"
}
