{
	"name": "solid-docs-next",
	"version": "1.0.0",
	"private": true,
	"description": "Docs for Solid",
	"type": "module",
	"scripts": {
		"sync:orama": "pnpm build && node scripts/sync-orama.mjs",
		"dev": "vite dev",
		"build": "vite build",
		"start": "vite start",
		"e2e": "npx playwright test",
		"format": "prettier . --write",
		"lint:fix": "eslint --flag unstable_native_nodejs_ts_config . --fix",
		"check:lint": "eslint --flag unstable_native_nodejs_ts_config .",
		"check:types": "tsc --noEmit",
		"sync:ref": "node scripts/extract-solid-ref.mjs"
	},
	"dependencies": {
		"@kobalte/core": "^0.13.12",
		"@kobalte/solidbase": "catalog:",
		"@solidjs/meta": "^0.29.4",
		"@solidjs/router": "^1.0.0",
		"@solidjs/start": "2.0.0",
		"@tailwindcss/vite": "^4.3.3",
		"dotenv": "^17.4.2",
		"nitro": "3.0.260610-beta",
		"resolve": "1.22.12",
		"solid-heroicons": "^3.2.4",
		"solid-js": "1.9.14",
		"solid-list": "^0.3.0",
		"solidbase-osmium": "workspace:*",
		"vite": "8.2.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@kobalte/tailwindcss": "^0.9.0",
		"@orama/crawly": "^0.0.6",
		"@tailwindcss/typography": "^0.5.20",
		"@types/node": "^25.9.5",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"eslint": "^10.7.0",
		"eslint-plugin-solid": "^0.14.5",
		"globals": "^17.7.0",
		"prettier": "3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.0",
		"typescript-eslint": "^8.65.0"
	},
	"overrides": {
		"@solidjs/start": "2.0.0"
	},
	"engines": {
		"node": ">=24",
		"pnpm": ">=11"
	},
	"packageManager": "pnpm@11.20.0"
}
